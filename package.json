{
  "name": "honeytrace-root",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:hardhat": "npm run hardhat:node --prefix backend",
    "deploy:local": "npm run deploy:local --prefix backend",
    "deploy:amoy": "npm run deploy:amoy --prefix backend",
    "dev": "concurrently --kill-others-on-fail -n \"HARDHAT,BACKEND,FRONTEND\" -c \"cyan,yellow,magenta\" \"npm run hardhat:node --prefix backend\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend",
    "seed": "npm run seed --prefix backend",
    "test:backend": "npm run test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
