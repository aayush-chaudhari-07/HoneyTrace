{
  "name": "honeytrace-backend",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "compile": "npx hardhat compile",
    "hardhat:node": "npx hardhat node",
    "deploy:local": "npx hardhat compile && node scripts/deploy_custody.js",
    "deploy:amoy": "npx hardhat compile && RPC_URL=https://rpc-amoy.polygon.technology node scripts/deploy_custody.js",
    "seed": "node scripts/seed_demo_data.js",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "ethers": "^6.17.0",
    "express": "^4.22.3",
    "html5-qrcode": "^2.3.8",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "drizzle-kit": "^0.31.11",
    "hardhat": "^2.29.1"
  }
}
